# llm-relay — full relay server env. Copy to .env, fill in, restart to change.
# Docs: README.md

# Required. A long random secret:  openssl rand -hex 32
JWT_SECRET=

# First-run bootstrap admin (created once; manage users in the dashboard after).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# URLs shown in the dashboard copy buttons and the agent guide. Include the
# scheme; a hostname or a plain IP:port both work (LAN hosting is fine).
PUBLIC_RELAY_URL=http://relay.example.fi:8080
PUBLIC_DASHBOARD_URL=http://relay.example.fi:8081

# Trust X-Forwarded-For from a reverse proxy. Keep false if the relay port is
# published directly to users — the header is then client-controlled. With a
# TLS-terminating proxy in front, set this true AND TLS_PORT=0: it then lets
# X-Forwarded-Proto: https satisfy the machine-channel TLS gate (federation +
# remote backends). With TLS_PORT!=0 the relay serves its own TLS and ignores
# the header (peers dial the wss listener).
TRUST_PROXY_HEADERS=false

# TLS listener for the machine channels (federation + remote-backend connect),
# serving the relay API over TLS with the cert generated on Settings → TLS.
# Set 0 when a reverse proxy terminates TLS instead (the common deployment).
TLS_PORT=8443
