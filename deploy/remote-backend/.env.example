# llm-relay — remote-backend connector env. Copy to .env, fill in, restart
# to change. No JWT_SECRET needed: a connector never serves the dashboard.
# Docs: docs/workflows/remote-backend.md

HEADLESS=true

# The relay to dial in to (server root, relay port) and the rb- connect
# token minted on its Backends page (+ Remote backend). BOTH REQUIRED.
RELAY_URL=https://relay.example.fi
RELAY_TOKEN=rb-

# Your local OpenAI-compatible engine, exposed through the relay. REQUIRED.
ENGINE_URL=http://localhost:8080
# ENGINE_TOKEN=             # bearer token for the engine, if it needs one
