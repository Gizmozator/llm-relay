# llm-relay — headless spoke env. Copy to .env, fill in, restart to change.
# Docs: docs/workflows/headless-spoke.md

# Required. A long random secret:  openssl rand -hex 32
JWT_SECRET=

HEADLESS=true

# Your local OpenAI-compatible engine and the ONE model this box shares.
BACKEND_URL=http://engine.example.fi:8080
MODEL_NAME=qwen3-coder
# BACKEND_TOKEN=            # bearer token for the backend, if it needs one

# The hub to join, and its fed-… server token (created on the hub's My keys page).
HUB_URL=https://relay.example.fi
HUB_TOKEN=fed-

# Optional price, integer micro-units per 1M tokens (0 = free).
PRICE_IN=0
PRICE_OUT=0
PRICE_CACHE_READ=0
PRICE_CACHE_WRITE=0
