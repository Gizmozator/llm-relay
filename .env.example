# llm-relay — local overrides. Copy to `.env` and edit.
# `.env` is gitignored; this example file is committed so the knobs are discoverable.

# HOST port you browse to (relay API).
# The container-internal listen port stays fixed at 8080 — it sits in its own
# network namespace and cannot collide with the host, so only the published host
# port above needs to be unique.
PORT=8080

# HOST port for the dashboard + admin API (put your reverse proxy here).
ADMIN_PORT=8081

# Required: signing key for dashboard JWTs. Generate: openssl rand -hex 32
JWT_SECRET=

# Optional: bootstrap admin account, created once on an empty database.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Set true when a reverse proxy fronts the relay port and sets X-Forwarded-For.
# With a TLS-terminating proxy it also lets X-Forwarded-Proto: https satisfy the
# machine-channel TLS gate (federation + remote backends) — but only when
# TLS_PORT=0 (a relay that binds its own TLS listener ignores the header).
TRUST_PROXY_HEADERS=false

# TLS listener for the machine channels (federation + remote-backend connect),
# serving the relay API over TLS with the cert generated on Settings → TLS.
# Set 0 when a reverse proxy terminates TLS instead (the common deployment);
# then X-Forwarded-Proto: https (with TRUST_PROXY_HEADERS=true) satisfies the gate.
TLS_PORT=8443

# URLs shown in the dashboard copy buttons and interpolated into the agent
# guide. Include the scheme; a hostname or a plain IP:port both work (direct
# LAN hosting: http://192.0.2.10:8080). The relay URL is the server ROOT
# WITHOUT the /v1 suffix — the dashboard appends /v1 where the OpenAI base
# URL is shown, and the agent endpoints ({root}/v1/agent-guide,
# {root}/v1/utilization, {root}/mcp) link off the root. Unset: the copy
# buttons stay empty and the guide keeps its {{RELAY_URL}} placeholder.
PUBLIC_RELAY_URL=
PUBLIC_DASHBOARD_URL=

# ---- Remote-backend connector (plan docs/plans/2026-11-24-remote-backend-v1.md) ----
# Connector mode: this box binds nothing and exposes ENGINE_URL to a relay
# over an outbound WebSocket. When HEADLESS=true the three REQUIRED vars
# below must be set (missing = boot error). No JWT_SECRET needed — a
# connector never serves the dashboard.
# HEADLESS=true
# The relay to dial in to (server root). REQUIRED, and must be https://.
# RELAY_URL=https://relay.example.fi
# The rb- connect token minted on the relay's Backends page. REQUIRED.
# RELAY_TOKEN=rb-...
# The relay cert fingerprint to pin when it uses a self-signed cert (Settings →
# TLS page). Empty verifies against the system CA store (a proxied real cert).
# RELAY_PIN=sha256:...
# The local OpenAI-compatible engine to expose. REQUIRED.
# ENGINE_URL=http://localhost:8080
# Optional bearer token for the engine.
# ENGINE_TOKEN=

# Container image. Points at the published multi-arch image (amd64 + arm64)
# in the Gitea registry. The local `docker-compose.yml` build tags its own
# build with this name too; the deploy stack (deploy/dockge-compose.yml) pulls it.
IMAGE=gitea.rantaeskola.fi/gizmoz/llm-relay:latest

# Timezone. NOTE: a `scratch` runtime image ships no tz database — the Go
# Dockerfile copies /usr/share/zoneinfo so this works. If you switch to a
# distroless or slim runtime, keep that COPY line or import time/tzdata.
TZ=Europe/Helsinki

# Put real secrets here, never in docker-compose.yml.
