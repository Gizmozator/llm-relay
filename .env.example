# llm-relay — local overrides. Copy to `.env` and edit.
# `.env` is gitignored; this example file is committed so the knobs are discoverable.

# HOST port you browse to (relay API).
# The container-internal listen port stays fixed at 8080 — it sits in its own
# network namespace and cannot collide with the host, so only the published host
# port above needs to be unique.
PORT=8080

# HOST port for the dashboard + admin API (put your reverse proxy here).
ADMIN_PORT=8081

# Required: signing key for dashboard JWTs. Generate: openssl rand -hex 32
JWT_SECRET=

# Optional: bootstrap admin account, created once on an empty database.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Set true when a reverse proxy fronts the relay port and sets X-Forwarded-For.
TRUST_PROXY_HEADERS=false

# URLs shown in the dashboard copy buttons and interpolated into the agent
# guide. Include the scheme; a hostname or a plain IP:port both work (direct
# LAN hosting: http://192.0.2.10:8080). The relay URL is the server ROOT
# WITHOUT the /v1 suffix — the dashboard appends /v1 where the OpenAI base
# URL is shown, and the agent endpoints ({root}/v1/agent-guide,
# {root}/v1/utilization, {root}/mcp) link off the root. Unset: the copy
# buttons stay empty and the guide keeps its {{RELAY_URL}} placeholder.
PUBLIC_RELAY_URL=
PUBLIC_DASHBOARD_URL=

# Container image tag
IMAGE=llm-relay:latest

# Timezone. NOTE: a `scratch` runtime image ships no tz database — the Go
# Dockerfile copies /usr/share/zoneinfo so this works. If you switch to a
# distroless or slim runtime, keep that COPY line or import time/tzdata.
TZ=Europe/Helsinki

# Put real secrets here, never in docker-compose.yml.
