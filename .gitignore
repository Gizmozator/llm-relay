# --- binaries / build output ---
/bin/
/build/
/dist/
/out/
/llm-relay
*.exe
*.out
*.test
*.prof

# --- local env / secrets ---
.env
.env.*
!.env.example
*.pem
*.key
credentials*

# --- runtime data / caches ---
/data/

# --- web dashboard build output ---
# web/dist is committed (go:embed needs it on a fresh clone); rebuild via
# `make web` refreshes it. The negation must come after the generic `dist/`
# rule above to take effect.
!web/dist/
/cache/
/tmp/
*.log
*.sqlite
*.sqlite3
*.db
node_modules/
__pycache__/
.venv/
.mypy_cache/
.pytest_cache/

# --- editor / OS noise ---
.idea/
.vscode/
*.swp
*~
.DS_Store

# --- agent scratch (keep the dir, ignore its contents) ---
.cache/
.pi/scratch/
